# Copie ce fichier en ".env" et remplis tes cles quand tu les auras.
# Tant que les cles sont vides, le systeme tourne en MODE DEMO
# (donnees d'exemple, jamais presentees comme reelles).

PORT=4000

# Football reel - https://www.api-football.com/
API_FOOTBALL_KEY=

# E-sport reel - https://pandascore.co/
PANDASCORE_KEY=

DB_PATH=./data/revizpredict.db
DEMO_MODE=true
